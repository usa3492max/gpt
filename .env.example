# ---------------------------------------------------------------------------
# redloop configuration. Copy to .env and fill in what you need.
#   cp .env.example .env
# The CLI reads .env automatically; real environment variables win over it.
# ---------------------------------------------------------------------------

# --- Model provider --------------------------------------------------------
# anthropic (default) | openai | ollama | lmstudio | openrouter | groq | mock
REDLOOP_PROVIDER=anthropic
REDLOOP_MODEL=claude-sonnet-4-5

# Claude. Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI, if you prefer it (also set REDLOOP_PROVIDER=openai)
OPENAI_API_KEY=

# Other hosted providers
OPENROUTER_API_KEY=
GROQ_API_KEY=

# --- Local models (Ollama / LM Studio / vLLM) ------------------------------
# Ollama running on the host. Inside Docker, "localhost" is the container, so
# use host.docker.internal (docker-compose.yml already maps it):
OLLAMA_HOST=http://host.docker.internal:11434
# Point the agent at it with either of:
#   REDLOOP_PROVIDER=ollama  +  REDLOOP_MODEL=qwen2.5-coder:14b
#   REDLOOP_BASE_URL=http://host.docker.internal:11434/v1
#
# LM Studio:   REDLOOP_PROVIDER=lmstudio  (defaults to http://localhost:1234/v1)
# Any OpenAI-compatible endpoint:
#   REDLOOP_PROVIDER=custom  REDLOOP_BASE_URL=https://gateway.internal/v1  REDLOOP_MODEL=my-model

# --- Engagement defaults ---------------------------------------------------
# Authorization acknowledgement. Setting this to 1 is equivalent to passing
# --i-am-authorized on every run. Only set it if every target you point this at
# is yours or covered by written permission.
# REDLOOP_AUTHORIZED=0

# Action / time / cost limits
REDLOOP_MAX_STEPS=40
REDLOOP_MAX_MINUTES=90
REDLOOP_MAX_COST_USD=0

# Per-command timeout in seconds, and how much output the model sees per action
REDLOOP_COMMAND_TIMEOUT=300
REDLOOP_MAX_OUTPUT_CHARS=6000

# Context window of the model (drives when history is compacted).
# Cloud models are large; a 7B local model is usually 8k-32k.
REDLOOP_CONTEXT_WINDOW=200000

# Extra hosts/CIDRs that are in scope beyond the target, comma separated
# REDLOOP_SCOPE=10.0.0.0/24,api.example.com

# Extra flag patterns (Python regex, comma separated)
# REDLOOP_FLAG_REGEX=SECRET\{[a-z0-9_]+\},DUCTF\{[^}]+\}

# Where run directories are written (inside the container)
REDLOOP_RUNS_DIR=/app/runs

# --- Presentation ----------------------------------------------------------
# REDLOOP_JSON_FEED=1        # machine-readable event stream on stdout
